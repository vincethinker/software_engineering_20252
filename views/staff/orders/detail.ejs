<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/orders" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0">Chi tiết đơn hàng</h4>
</div>

<%
const badgeMap = {
  pending: 'bg-warning text-dark',
  confirmed: 'bg-primary',
  preparing: 'bg-info text-dark',
  completed: 'bg-success',
  cancelled: 'bg-secondary'
};

const statusVN = {
  pending: 'Chờ xử lý',
  confirmed: 'Đã xác nhận',
  preparing: 'Đang chuẩn bị',
  completed: 'Hoàn thành',
  cancelled: 'Đã hủy'
};

const orderTypeVN = {
  takeaway: 'Mang về',
  dine_in: 'Dùng tại quán'
};

const paymentMethodVN = {
  bank: 'Thẻ ngân hàng',
  cash: 'Tiền mặt'
};

const paymentStatusVN = {
  paid: 'Đã thanh toán',
  unpaid: 'Chưa thanh toán'
};

const badge = badgeMap[order.status] || 'bg-secondary';
%>

<div class="card p-4 mb-4" style="max-width:760px">
  <div class="row g-3">
    <div class="col-6">
      <div class="text-muted small">Mã đơn</div>
      <code><%= order._id %></code>
    </div>

    <div class="col-6">
      <div class="text-muted small">Ngày đặt</div>
      <%= order.createdAt ? new Date(order.createdAt).toLocaleString('vi-VN') : '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Khách hàng</div>
      <strong><%= order.customerName || '—' %></strong>
    </div>

    <div class="col-6">
      <div class="text-muted small">Số điện thoại</div>
      <%= order.phone || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Email</div>
      <%= order.email || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Loại đơn</div>
      <%= orderTypeVN[order.orderType] || order.orderType || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Phương thức thanh toán</div>
      <%= paymentMethodVN[order.paymentMethod] || order.paymentMethod || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Trạng thái thanh toán</div>
      <%= paymentStatusVN[order.paymentStatus] || order.paymentStatus || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Trạng thái đơn</div>
      <span class="badge <%= badge %>">
        <%= statusVN[order.status] || order.status %>
      </span>
    </div>

    <div class="col-6">
      <div class="text-muted small">Tổng tiền</div>
      <strong><%= Number(order.totalAmount || 0).toLocaleString('vi-VN') %>đ</strong>
    </div>

    <div class="col-12">
      <div class="text-muted small">Ghi chú</div>
      <%= order.note || '—' %>
    </div>
  </div>

  <hr class="my-3">

  <form action="/staff/orders/<%= order._id %>/status" method="POST" class="d-flex gap-2 align-items-center">
    <label class="form-label mb-0 text-muted small">Cập nhật trạng thái:</label>

    <select name="status" class="form-select form-select-sm" style="width:170px">
      <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Chờ xử lý</option>
      <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
      <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>Đang chuẩn bị</option>
      <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
      <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
    </select>

    <button type="submit" class="btn btn-sm btn-primary">Lưu</button>
  </form>
</div>

<h5 class="mb-2">Sản phẩm trong đơn</h5>

<div class="card mb-4">
  <table class="table mb-0">
    <thead class="table-light">
      <tr>
        <th>Tên sản phẩm</th>
        <th>Loại</th>
        <th>Đơn giá</th>
        <th>SL</th>
        <th>Thành tiền</th>
      </tr>
    </thead>

    <tbody>
      <% if (!order.items || order.items.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center text-muted py-4">
            Không có sản phẩm nào trong đơn này.
          </td>
        </tr>
      <% } %>

      <% order.items.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td>
            <%= item.type === 'drink' ? 'Đồ uống' : item.type === 'snack' ? 'Đồ ăn' : 'Sách' %>
          </td>
          <td><%= Number(item.price).toLocaleString('vi-VN') %>đ</td>
          <td><%= item.quantity %></td>
          <td><%= Number(item.price * item.quantity).toLocaleString('vi-VN') %>đ</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>