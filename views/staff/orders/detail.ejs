<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/orders" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0">Chi tiết đơn hàng</h4>
</div>

<%
const badgeMap    = { pending:'bg-warning text-dark', preparing:'bg-info text-dark', ready:'bg-primary', completed:'bg-success', cancelled:'bg-secondary' };
const statusVN    = { pending:'Chờ xử lý', preparing:'Đang chuẩn bị', ready:'Sẵn sàng', completed:'Hoàn thành', cancelled:'Đã hủy' };
const orderTypeVN = { 'dine-in':'Tại chỗ', takeaway:'Mang về', delivery:'Giao hàng' };
const badge       = badgeMap[order.order_status] || 'bg-secondary';
%>

<div class="card p-4 mb-4" style="max-width:600px">
  <div class="row g-3">
    <div class="col-6"><div class="text-muted small">Mã đơn</div><code><%= order._id %></code></div>
    <div class="col-6"><div class="text-muted small">Ngày đặt</div><%= new Date(order.order_date).toLocaleString('vi-VN') %></div>
    <div class="col-6"><div class="text-muted small">Loại</div><%= orderTypeVN[order.order_type] || order.order_type %></div>
    <div class="col-6"><div class="text-muted small">Trạng thái</div><span class="badge <%= badge %>"><%= statusVN[order.order_status] || order.order_status %></span></div>
    <div class="col-6"><div class="text-muted small">Tổng tiền</div><strong><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</strong></div>
  </div>
  <hr class="my-3">
  <form action="/staff/orders/<%= order._id %>/status" method="POST" class="d-flex gap-2 align-items-center">
    <label class="form-label mb-0 text-muted small">Cập nhật trạng thái:</label>
    <select name="order_status" class="form-select form-select-sm" style="width:160px">
      <option value="pending"   <%= order.order_status==='pending'   ?'selected':'' %>>Chờ xử lý</option>
      <option value="preparing" <%= order.order_status==='preparing' ?'selected':'' %>>Đang chuẩn bị</option>
      <option value="ready"     <%= order.order_status==='ready'     ?'selected':'' %>>Sẵn sàng</option>
      <option value="completed" <%= order.order_status==='completed' ?'selected':'' %>>Hoàn thành</option>
      <option value="cancelled" <%= order.order_status==='cancelled' ?'selected':'' %>>Đã hủy</option>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">Lưu</button>
  </form>
</div>

<% if (bookItems.length > 0) { %>
  <h5 class="mb-2">Sách đã đặt</h5>
  <div class="card mb-4">
    <table class="table mb-0">
      <thead class="table-light"><tr><th>Tiêu đề</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
      <tbody>
        <% bookItems.forEach(item => { %>
          <tr>
            <td><%= item.book_id ? item.book_id.title : '(đã xóa)' %></td>
            <td><%= Number(item.unit_price).toLocaleString('vi-VN') %>đ</td>
            <td><%= item.quantity %></td>
            <td><%= Number(item.unit_price * item.quantity).toLocaleString('vi-VN') %>đ</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (drinkItems.length > 0) { %>
  <h5 class="mb-2">Đồ uống đã đặt</h5>
  <div class="card mb-4">
    <table class="table mb-0">
      <thead class="table-light"><tr><th>Tên</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
      <tbody>
        <% drinkItems.forEach(item => { %>
          <tr>
            <td><%= item.drink_id ? item.drink_id.drink_name : '(đã xóa)' %></td>
            <td><%= Number(item.unit_price).toLocaleString('vi-VN') %>đ</td>
            <td><%= item.quantity %></td>
            <td><%= Number(item.unit_price * item.quantity).toLocaleString('vi-VN') %>đ</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (bookItems.length === 0 && drinkItems.length === 0) { %>
  <p class="text-muted">Không có sản phẩm nào trong đơn này.</p>
<% } %>

<%- include('../../partials/staff-footer') %>
