<%- include('../../partials/staff-header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Đơn hàng</h4>
  <a href="/staff/orders/add" class="btn btn-primary btn-sm">+ Tạo đơn hàng</a>
</div>

<ul class="nav nav-pills mb-3">
  <% [['all','Tất cả'],['pending','Chờ xử lý'],['preparing','Đang chuẩn bị'],['ready','Sẵn sàng'],['completed','Hoàn thành'],['cancelled','Đã hủy']].forEach(([val,label]) => { %>
    <li class="nav-item">
      <a class="nav-link <%= currentStatus === val ? 'active' : '' %>" href="/staff/orders?status=<%= val %>"><%= label %></a>
    </li>
  <% }) %>
</ul>

<%
const orderStatusVN = { pending:'Chờ xử lý', preparing:'Đang chuẩn bị', ready:'Sẵn sàng', completed:'Hoàn thành', cancelled:'Đã hủy' };
const orderTypeVN   = { 'dine-in':'Tại chỗ', takeaway:'Mang về', delivery:'Giao hàng' };
const badgeMap      = { pending:'bg-warning text-dark', preparing:'bg-info text-dark', ready:'bg-primary', completed:'bg-success', cancelled:'bg-secondary' };
%>

<div class="card">
  <table class="table table-hover mb-0">
    <thead class="table-dark">
      <tr>
        <th>Mã đơn</th><th>Ngày</th><th>Loại</th><th>Tổng tiền</th><th>Trạng thái</th><th>Cập nhật</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td></tr>
      <% } %>
      <% orders.forEach(order => { %>
        <tr>
          <td><code><%= order._id.toString().slice(-8) %></code></td>
          <td><%= new Date(order.order_date).toLocaleString('vi-VN') %></td>
          <td><%= orderTypeVN[order.order_type] || order.order_type %></td>
          <td><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</td>
          <td><span class="badge <%= badgeMap[order.order_status] %>"><%= orderStatusVN[order.order_status] || order.order_status %></span></td>
          <td>
            <form action="/staff/orders/<%= order._id %>/status" method="POST" class="d-flex gap-1">
              <select name="order_status" class="form-select form-select-sm" style="width:150px">
                <option value="pending"   <%= order.order_status==='pending'   ?'selected':'' %>>Chờ xử lý</option>
                <option value="preparing" <%= order.order_status==='preparing' ?'selected':'' %>>Đang chuẩn bị</option>
                <option value="ready"     <%= order.order_status==='ready'     ?'selected':'' %>>Sẵn sàng</option>
                <option value="completed" <%= order.order_status==='completed' ?'selected':'' %>>Hoàn thành</option>
                <option value="cancelled" <%= order.order_status==='cancelled' ?'selected':'' %>>Đã hủy</option>
              </select>
              <button type="submit" class="btn btn-sm btn-outline-primary">Lưu</button>
            </form>
          </td>
          <td><a href="/staff/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">Xem</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>
