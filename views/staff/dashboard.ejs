<%- include('../partials/staff-header') %>

<div class="dashboard-header">
  <h1>Tổng quan</h1>
  <p>
    <%= new Date().toLocaleDateString('vi-VN', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) %>
  </p>
</div>

<div class="dashboard-grid">
  <div class="dashboard-card">
    <h3>Đơn hàng chờ xử lý</h3>
    <div class="dashboard-number"><%= pendingOrders || 0 %></div>
    <a href="/staff/orders?status=pending">Xem đơn hàng →</a>
  </div>

  <div class="dashboard-card">
    <h3>Đơn hàng hôm nay</h3>
    <div class="dashboard-number"><%= ordersToday || 0 %></div>
    <a href="/staff/orders">Xem tất cả →</a>
  </div>

  <div class="dashboard-card">
    <h3>Đặt chỗ chờ xác nhận</h3>
    <div class="dashboard-number"><%= pendingBookings || 0 %></div>
    <a href="/staff/bookings?status=pending">Xem đặt chỗ →</a>
  </div>

  <div class="dashboard-card">
    <h3>Sách trong kho</h3>
    <div class="dashboard-number"><%= bookStock || 0 %></div>
    <a href="/staff/books">Xem sách →</a>
  </div>

  <div class="dashboard-card">
    <h3>Đồ uống còn</h3>
    <div class="dashboard-number"><%= drinkStock || 0 %></div>
    <a href="/staff/drinks">Xem đồ uống →</a>
  </div>

  <div class="dashboard-card">
    <h3>Đồ ăn còn</h3>
    <div class="dashboard-number"><%= snackStock || 0 %></div>
    <a href="/staff/snacks">Xem đồ ăn →</a>
  </div>
</div>

<hr>

<div class="quick-actions">
  <h3>Thao tác nhanh</h3>

  <div class="quick-action-buttons">
    <a href="/staff/books/add" class="btn btn-outline-primary">+ Thêm sách</a>
    <a href="/staff/drinks/add" class="btn btn-outline-primary">+ Thêm đồ uống</a>
    <a href="/staff/snacks/add" class="btn btn-outline-primary">+ Thêm đồ ăn</a>
    <a href="/staff/orders" class="btn btn-outline-primary">Tất cả đơn hàng</a>
    <a href="/staff/bookings" class="btn btn-outline-primary">Tất cả đặt chỗ</a>
  </div>
</div>

<%- include('../partials/staff-footer') %>