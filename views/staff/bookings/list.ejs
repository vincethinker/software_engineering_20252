<%- include('../../partials/staff-header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Đặt chỗ / Sự kiện</h4>
  <a href="/staff/bookings/add" class="btn btn-primary btn-sm">+ Tạo đặt chỗ</a>
</div>

<ul class="nav nav-pills mb-3">
  <% [['all','Tất cả'],['pending','Chờ xác nhận'],['confirmed','Đã xác nhận'],['cancelled','Đã hủy']].forEach(([val,label]) => { %>
    <li class="nav-item">
      <a class="nav-link <%= currentStatus === val ? 'active' : '' %>" href="/staff/bookings?status=<%= val %>">
        <%= label %>
      </a>
    </li>
  <% }) %>
</ul>

<%
const badgeMap = {
  pending: 'bg-warning text-dark',
  confirmed: 'bg-success',
  cancelled: 'bg-secondary'
};

const statusVN = {
  pending: 'Chờ xác nhận',
  confirmed: 'Đã xác nhận',
  cancelled: 'Đã hủy'
};

const eventTypeVN = {
  talkshow: 'Talking show',
  workshop: 'Workshop',
  meeting: 'Họp nhóm',
  study: 'Học tập / làm việc nhóm',
  other: 'Khác'
};
%>

<div class="card">
  <table class="table table-hover mb-0">
    <thead class="table-dark">
      <tr>
        <th>Khách hàng</th>
        <th>SĐT</th>
        <th>Tên sự kiện</th>
        <th>Loại</th>
        <th>Ngày</th>
        <th>Giờ</th>
        <th>Số người</th>
        <th>Thực đơn</th>
        <th>Báo giá</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>

    <tbody>
      <% if (bookings.length === 0) { %>
        <tr>
          <td colspan="11" class="text-center text-muted py-4">
            Chưa có đặt chỗ nào.
          </td>
        </tr>
      <% } %>

      <% bookings.forEach(booking => { %>
        <tr>
          <td>
            <strong><%= booking.customerName || '—' %></strong>
            <% if (booking.isSeenByStaff === false) { %>
              <span class="badge bg-danger ms-1">Mới</span>
            <% } %>
          </td>

          <td><%= booking.phone || '—' %></td>

          <td><%= booking.eventName || '—' %></td>

          <td>
            <%= eventTypeVN[booking.eventType] || booking.eventType || '—' %>
          </td>

          <td>
            <%= booking.eventDate ? new Date(booking.eventDate).toLocaleDateString('vi-VN') : '—' %>
          </td>

          <td><%= booking.eventTime || '—' %></td>

          <td><%= booking.participantCount || 0 %> người</td>

          <td>
            <% if (booking.selectedMenu && booking.selectedMenu.length > 0) { %>
              <ul class="mb-0 ps-3">
                <% booking.selectedMenu.forEach(item => { %>
                  <li>
                    <%= item.name %> x <%= item.quantity %>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <span class="text-muted small">Không có</span>
            <% } %>
          </td>

          <td>
            <%= Number(booking.estimatedTotal || 0).toLocaleString('vi-VN') %>đ
          </td>

          <td>
            <span class="badge <%= badgeMap[booking.status] || 'bg-secondary' %>">
              <%= statusVN[booking.status] || booking.status %>
            </span>
          </td>

          <td class="d-flex gap-1">
            <% if (booking.status === 'pending') { %>
              <form action="/staff/bookings/<%= booking._id %>/status" method="POST">
                <input type="hidden" name="status" value="confirmed">
                <button type="submit" class="btn btn-sm btn-success">
                  Xác nhận
                </button>
              </form>

              <form action="/staff/bookings/<%= booking._id %>/status" method="POST" onsubmit="return confirm('Hủy đặt chỗ này?')">
                <input type="hidden" name="status" value="cancelled">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  Hủy
                </button>
              </form>
            <% } else if (booking.status === 'confirmed') { %>
              <form action="/staff/bookings/<%= booking._id %>/status" method="POST" onsubmit="return confirm('Hủy đặt chỗ đã xác nhận?')">
                <input type="hidden" name="status" value="cancelled">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  Hủy
                </button>
              </form>
            <% } else { %>
              <span class="text-muted small">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>