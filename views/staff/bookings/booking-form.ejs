<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/bookings" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0">Tạo đặt chỗ mới</h4>
</div>

<form action="/staff/bookings/add" method="POST" class="card p-4" style="max-width:760px">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Tên khách hàng <span class="text-danger">*</span></label>
      <input name="customerName" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
      <input name="phone" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Email</label>
      <input name="email" type="email" class="form-control">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Tên sự kiện / mục đích</label>
      <input name="eventName" class="form-control" value="Đặt chỗ làm việc">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Loại sự kiện</label>
      <select name="eventType" class="form-select">
        <option value="study">Học tập / làm việc nhóm</option>
        <option value="meeting">Họp nhóm</option>
        <option value="workshop">Workshop</option>
        <option value="talkshow">Talking show</option>
        <option value="other">Khác</option>
      </select>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Ngày tổ chức <span class="text-danger">*</span></label>
      <input type="date" name="eventDate" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
      <input type="time" name="eventTime" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Số người <span class="text-danger">*</span></label>
      <input type="number" name="participantCount" class="form-control" required min="1" value="1">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Thời lượng</label>
      <select name="duration" class="form-select">
        <option value="1">1 giờ</option>
        <option value="2">2 giờ</option>
        <option value="3">3 giờ</option>
        <option value="4">4 giờ</option>
        <option value="full_day">Cả buổi</option>
      </select>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Trạng thái</label>
      <select name="status" class="form-select">
        <option value="pending">Chờ xác nhận</option>
        <option value="confirmed">Đã xác nhận</option>
      </select>
    </div>

    <div class="col-md-12 mb-4">
      <label class="form-label">Ghi chú</label>
      <textarea name="note" class="form-control" rows="2"></textarea>
    </div>
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Tạo đặt chỗ</button>
    <a href="/staff/bookings" class="btn btn-outline-secondary">Hủy</a>
  </div>
</form>

<%- include('../../partials/staff-footer') %>