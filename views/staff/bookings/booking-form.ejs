<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/bookings" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0">Tạo đặt chỗ mới</h4>
</div>

<form action="/staff/bookings/add" method="POST" class="card p-4" style="max-width:760px">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Tên khách hàng <span class="text-danger">*</span></label>
      <input name="customerName" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
      <input name="phone" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Email</label>
      <input name="email" type="email" class="form-control">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Tên sự kiện / mục đích</label>
      <input name="eventName" class="form-control" value="Đặt chỗ làm việc">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Loại sự kiện</label>
      <select name="eventType" class="form-select">
        <option value="study">Học tập / làm việc nhóm</option>
        <option value="meeting">Họp nhóm</option>
        <option value="workshop">Workshop</option>
        <option value="talkshow">Talking show</option>
        <option value="other">Khác</option>
      </select>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Ngày tổ chức <span class="text-danger">*</span></label>
      <input type="date" name="eventDate" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
      <input type="time" name="eventTime" class="form-control" required>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Số người <span class="text-danger">*</span></label>
      <input type="number" name="participantCount" class="form-control" required min="1" value="1">
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Thời lượng</label>
      <select name="duration" class="form-select">
        <option value="1">1 giờ</option>
        <option value="2">2 giờ</option>
        <option value="3">3 giờ</option>
        <option value="4">4 giờ</option>
        <option value="full_day">Cả buổi</option>
      </select>
    </div>

    <div class="col-md-6 mb-3">
      <label class="form-label">Trạng thái</label>
      <select name="status" class="form-select">
        <option value="pending">Chờ xác nhận</option>
        <option value="confirmed">Đã xác nhận</option>
        <option value="cancelled">Đã hủy</option>
      </select>
      <div class="form-text">
        Nếu chọn “Đã xác nhận”, hệ thống sẽ tự thanh toán, trừ kho và cộng điểm nếu là khách hàng thân thiết.
      </div>
    </div>

    <div class="col-md-12 mb-4">
      <label class="form-label">Ghi chú</label>
      <textarea name="note" class="form-control" rows="2"></textarea>
    </div>
  </div>

  <hr>

  <div class="mb-3">
    <h5 class="mb-1">Thực đơn đi kèm</h5>
    <div class="text-muted small">
      Có thể chọn đồ uống / đồ ăn đi kèm đặt chỗ. Nếu không chọn, đặt chỗ chỉ tính phí không gian.
    </div>
  </div>

  <div id="booking-product-list">
    <div class="row g-2 mb-2 booking-product-row">
      <div class="col-md-8">
        <label class="form-label">Sản phẩm</label>
        <select name="product_id" class="form-select">
          <option value="">-- Chọn sản phẩm --</option>

          <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
            <% products.forEach(product => { %>
              <option
                value="<%= product._id %>"
                <%= Number(product.stock || 0) <= 0 ? 'disabled' : '' %>
              >
                <%= product.type === 'drink' ? '[Đồ uống]' : '[Đồ ăn]' %>
                <%= product.name %>
                -
                <%= Number(product.price || 0).toLocaleString('vi-VN') %>đ
                -
                còn <%= product.stock || 0 %>
                <%= Number(product.stock || 0) <= 0 ? ' - Hết hàng' : '' %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Số lượng</label>
        <input type="number" name="product_qty" class="form-control" min="1" value="1">
      </div>

      <div class="col-md-1 d-flex align-items-end">
        <button type="button" class="btn btn-outline-danger remove-booking-product-row">×</button>
      </div>
    </div>
  </div>

  <button type="button" class="btn btn-outline-primary w-100 mb-4" id="add-booking-product-row">
    + Thêm sản phẩm
  </button>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Tạo đặt chỗ</button>
    <a href="/staff/bookings" class="btn btn-outline-secondary">Hủy</a>
  </div>
</form>

<script>
  const bookingProductList = document.getElementById("booking-product-list");
  const addBookingProductRowButton = document.getElementById("add-booking-product-row");

  if (bookingProductList && addBookingProductRowButton) {
    addBookingProductRowButton.addEventListener("click", function () {
      const firstRow = bookingProductList.querySelector(".booking-product-row");

      if (!firstRow) return;

      const newRow = firstRow.cloneNode(true);

      const select = newRow.querySelector("select");
      const input = newRow.querySelector("input");

      if (select) select.value = "";
      if (input) input.value = "1";

      bookingProductList.appendChild(newRow);
    });

    bookingProductList.addEventListener("click", function (event) {
      if (!event.target.classList.contains("remove-booking-product-row")) {
        return;
      }

      const rows = bookingProductList.querySelectorAll(".booking-product-row");

      if (rows.length <= 1) {
        const row = event.target.closest(".booking-product-row");

        if (row) {
          const select = row.querySelector("select");
          const input = row.querySelector("input");

          if (select) select.value = "";
          if (input) input.value = "1";
        }

        return;
      }

      const row = event.target.closest(".booking-product-row");

      if (row) {
        row.remove();
      }
    });
  }
</script>

<%- include('../../partials/staff-footer') %>