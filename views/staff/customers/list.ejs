<%- include('../../partials/staff-header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Khách hàng</h4>
  <a href="/staff/customers/add" class="btn btn-primary btn-sm">+ Thêm khách hàng</a>
</div>

<div class="card">
  <table class="table table-hover mb-0">
    <thead class="table-dark">
      <tr>
        <th>Họ tên</th>
        <th>Số điện thoại</th>
        <th>Email</th>
        <th>Trạng thái VIP</th>
        <th>Điểm</th>
        <th>Ngày tham gia</th>
        <th>Thao tác</th>
      </tr>
    </thead>

    <tbody>
      <% if (!customers || customers.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center text-muted py-4">
            Chưa có khách hàng nào.
          </td>
        </tr>
      <% } %>

      <% customers.forEach(customer => { %>
        <tr>
          <td>
            <strong><%= customer.fullName || '—' %></strong>
          </td>

          <td><%= customer.phone || '—' %></td>

          <td><%= customer.email || '—' %></td>

          <td>
            <% if (customer.membershipLevel) { %>
              <span class="badge bg-success">
                <%= customer.membershipLevel %>
              </span>
            <% } else { %>
              <span class="badge bg-secondary">Đồng</span>
            <% } %>
          </td>

          <td>
            <%= Number(customer.points || 0).toLocaleString('vi-VN') %>
          </td>

          <td>
            <%= customer.createdAt ? new Date(customer.createdAt).toLocaleDateString('vi-VN') : '—' %>
          </td>

          <td>
            <a href="/staff/customers/<%= customer._id %>" class="btn btn-sm btn-outline-secondary">
              Xem
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>