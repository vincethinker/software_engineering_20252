<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/customers" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0">Chi tiết khách hàng</h4>
</div>

<div class="card p-4" style="max-width:760px">
  <div class="row g-3">
    <div class="col-6">
      <div class="text-muted small">Họ tên</div>
      <strong><%= customer.fullName || '—' %></strong>
    </div>

    <div class="col-6">
      <div class="text-muted small">Số điện thoại</div>
      <%= customer.phone || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Email</div>
      <%= customer.email || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">CCCD</div>
      <%= customer.identityNumber || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Giới tính</div>
      <% if (customer.gender === 'male') { %>
        Nam
      <% } else if (customer.gender === 'female') { %>
        Nữ
      <% } else if (customer.gender === 'other') { %>
        Khác
      <% } else { %>
        —
      <% } %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Ngày sinh</div>
      <%= customer.birthday || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Hạng thành viên</div>
      <span class="badge bg-success">
        <%= customer.membershipLevel || 'Đồng' %>
      </span>
    </div>

    <div class="col-6">
      <div class="text-muted small">Điểm tích lũy</div>
      <strong><%= Number(customer.points || 0).toLocaleString('vi-VN') %></strong>
    </div>

    <div class="col-12">
      <div class="text-muted small">Địa chỉ</div>
      <%= [customer.address, customer.ward, customer.district, customer.city].filter(Boolean).join(', ') || '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Ngày tham gia</div>
      <%= customer.createdAt ? new Date(customer.createdAt).toLocaleString('vi-VN') : '—' %>
    </div>

    <div class="col-6">
      <div class="text-muted small">Trạng thái tài khoản</div>
      <% if (customer.isActive === false) { %>
        <span class="badge bg-danger">Đã khóa</span>
      <% } else { %>
        <span class="badge bg-success">Đang hoạt động</span>
      <% } %>
    </div>
  </div>
</div>

<%- include('../../partials/staff-footer') %>