<%- include('../../partials/staff-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Sách</h4>
  <a href="/staff/books/add" class="btn btn-primary btn-sm">+ Thêm sách</a>
</div>

<div class="card">
  <table class="table table-hover mb-0">
    <thead class="table-dark">
      <tr>
        <th>Tiêu đề</th>
        <th>Tác giả</th>
        <th>Nhà xuất bản</th>
        <th>Giá</th>
        <th>Tồn kho</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>
    <tbody>
      <% if (books.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có sách nào.</td></tr>
      <% } %>
      <% books.forEach(book => { %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.author %></td>
          <td><%= book.publisher || '—' %></td>
          <td><%= Number(book.price).toLocaleString('vi-VN') %>đ</td>
          <td><%= book.quantity ?? '—' %></td>
          <td>
            <span class="badge <%= book.status === 'available' ? 'bg-success' : 'bg-secondary' %>">
              <%= book.status === 'available' ? 'Còn hàng' : 'Hết hàng' %>
            </span>
          </td>
          <td class="d-flex gap-1">
            <a href="/staff/books/<%= book._id %>/edit" class="btn btn-sm btn-outline-secondary">Sửa</a>
            <form action="/staff/books/<%= book._id %>/delete" method="POST"
                  onsubmit="return confirm('Xóa sách này?')">
              <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>
