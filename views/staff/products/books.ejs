<%- include('../../partials/staff-header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Sách</h4>
  <a href="/staff/books/add" class="btn btn-primary btn-sm">+ Thêm sách</a>
</div>

<div class="card">
  <table class="table table-hover mb-0">
    <thead class="table-dark">
      <tr>
        <th>Ảnh</th>
        <th>Tiêu đề</th>
        <th>Tác giả</th>
        <th>Nhà xuất bản</th>
        <th>Giá</th>
        <th>Tồn kho</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>

    <tbody>
      <% if (books.length === 0) { %>
        <tr>
          <td colspan="8" class="text-center text-muted py-4">Chưa có sách nào.</td>
        </tr>
      <% } %>

      <% books.forEach(book => { %>
        <tr>
          <td>
            <% if (book.imageUrl) { %>
              <img class="staff-product-thumb" src="http://localhost:3000<%= book.imageUrl %>" alt="<%= book.name %>">
            <% } else { %>
              <span class="text-muted small">Không có ảnh</span>
            <% } %>
          </td>

          <td><strong><%= book.name %></strong></td>
          <td><%= book.author || '—' %></td>
          <td><%= book.publisher || '—' %></td>
          <td><%= Number(book.price || 0).toLocaleString('vi-VN') %>đ</td>
          <td><%= book.stock || 0 %></td>

          <td>
            <% if (book.status === 'out_of_stock' || Number(book.stock || 0) <= 0) { %>
              <span class="badge bg-danger">Hết hàng</span>
            <% } else { %>
              <span class="badge bg-success">Còn hàng</span>
            <% } %>
          </td>

          <td class="d-flex gap-1">
            <a href="/staff/books/<%= book._id %>/edit" class="btn btn-sm btn-outline-secondary">Sửa</a>

            <form action="/staff/books/<%= book._id %>/delete" method="POST" onsubmit="return confirm('Xóa sách này?')">
              <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/staff-footer') %>