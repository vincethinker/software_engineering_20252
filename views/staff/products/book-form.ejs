<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/books" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0"><%= product ? 'Sửa sách' : 'Thêm sách' %></h4>
</div>

<form action="<%= action %>" method="POST" enctype="multipart/form-data" class="card p-4" style="max-width:760px">
  <div class="mb-3">
    <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
    <input name="name" class="form-control" required value="<%= product ? product.name : '' %>">
  </div>

  <div class="mb-3">
    <label class="form-label">Tác giả <span class="text-danger">*</span></label>
    <input name="author" class="form-control" required value="<%= product ? product.author : '' %>">
  </div>

  <div class="mb-3">
    <label class="form-label">Nhà xuất bản</label>
    <input name="publisher" class="form-control" value="<%= product ? product.publisher : '' %>">
  </div>

  <div class="mb-3">
    <label class="form-label">Ảnh sản phẩm</label>
    <input type="file" name="image" accept="image/*" class="form-control">

    <% if (product && product.imageUrl) { %>
      <div class="mt-2">
        <img class="staff-form-preview" src="http://localhost:3000<%= product.imageUrl %>" alt="<%= product.name %>">
      </div>
    <% } %>
  </div>

  <div class="row">
    <div class="col mb-3">
      <label class="form-label">Giá (VND) <span class="text-danger">*</span></label>
      <input type="number" name="price" class="form-control" required min="0" value="<%= product ? product.price : '' %>">
    </div>

    <div class="col mb-3">
      <label class="form-label">Số lượng tồn kho</label>
      <input type="number" name="stock" class="form-control" min="0" value="<%= product ? product.stock : 0 %>">
    </div>
  </div>

  <div class="mb-4">
    <label class="form-label">Trạng thái</label>
    <select name="status" class="form-select">
      <option value="available" <%= product && product.status === 'available' ? 'selected' : '' %>>Còn hàng</option>
      <option value="out_of_stock" <%= product && product.status === 'out_of_stock' ? 'selected' : '' %>>Hết hàng</option>
      <option value="hidden" <%= product && product.status === 'hidden' ? 'selected' : '' %>>Ẩn</option>
    </select>
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary"><%= product ? 'Lưu thay đổi' : 'Thêm sách' %></button>
    <a href="/staff/books" class="btn btn-outline-secondary">Hủy</a>
  </div>
</form>

<%- include('../../partials/staff-footer') %>