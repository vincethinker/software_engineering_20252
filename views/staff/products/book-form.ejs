<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/books" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0"><%= book ? 'Chỉnh sửa sách' : 'Thêm sách' %></h4>
</div>

<div class="card p-4" style="max-width:600px">
  <form action="<%= action %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
      <input type="text" name="title" class="form-control" required value="<%= book ? book.title : '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Tác giả <span class="text-danger">*</span></label>
      <input type="text" name="author" class="form-control" required value="<%= book ? book.author : '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Nhà xuất bản</label>
      <input type="text" name="publisher" class="form-control" value="<%= book ? book.publisher : '' %>">
    </div>
    <div class="row">
      <div class="col mb-3">
        <label class="form-label">Giá (VND) <span class="text-danger">*</span></label>
        <input type="number" name="price" class="form-control" step="0.01" required min="0" value="<%= book ? book.price : '' %>">
      </div>
      <div class="col mb-3">
        <label class="form-label">Số lượng tồn kho</label>
        <input type="number" name="quantity" class="form-control" min="0" value="<%= book ? book.quantity : '' %>">
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label">Trạng thái</label>
      <select name="status" class="form-select">
        <option value="available"   <%= book && book.status === 'available'   ? 'selected' : '' %>>Còn hàng</option>
        <option value="unavailable" <%= book && book.status === 'unavailable' ? 'selected' : '' %>>Hết hàng</option>
      </select>
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary"><%= book ? 'Lưu thay đổi' : 'Thêm sách' %></button>
      <a href="/staff/books" class="btn btn-outline-secondary">Hủy</a>
    </div>
  </form>
</div>

<%- include('../../partials/staff-footer') %>
