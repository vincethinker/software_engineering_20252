<%- include('../../partials/staff-header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/staff/drinks" class="btn btn-sm btn-outline-secondary">← Quay lại</a>
  <h4 class="mb-0"><%= drink ? 'Chỉnh sửa đồ uống' : 'Thêm đồ uống' %></h4>
</div>

<div class="card p-4" style="max-width:600px">
  <form action="<%= action %>" method="POST">
    <div class="mb-3">
      <label class="form-label">Tên <span class="text-danger">*</span></label>
      <input type="text" name="drink_name" class="form-control" required value="<%= drink ? drink.drink_name : '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Danh mục</label>
      <input type="text" name="category" class="form-control" placeholder="VD: Cà phê, Trà, Nước ép" value="<%= drink ? drink.category : '' %>">
    </div>
    <div class="row">
      <div class="col mb-3">
        <label class="form-label">Giá (VND) <span class="text-danger">*</span></label>
        <input type="number" name="price" class="form-control" step="0.01" required min="0" value="<%= drink ? drink.price : '' %>">
      </div>
      <div class="col mb-3">
        <label class="form-label">Số lượng tồn kho</label>
        <input type="number" name="quantity" class="form-control" min="0" value="<%= drink ? drink.quantity : '' %>">
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label">Trạng thái</label>
      <select name="status" class="form-select">
        <option value="available"   <%= drink && drink.status === 'available'   ? 'selected' : '' %>>Còn hàng</option>
        <option value="unavailable" <%= drink && drink.status === 'unavailable' ? 'selected' : '' %>>Hết hàng</option>
      </select>
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary"><%= drink ? 'Lưu thay đổi' : 'Thêm đồ uống' %></button>
      <a href="/staff/drinks" class="btn btn-outline-secondary">Hủy</a>
    </div>
  </form>
</div>

<%- include('../../partials/staff-footer') %>
