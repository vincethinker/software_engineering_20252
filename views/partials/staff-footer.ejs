</div><!-- /lc-main -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="http://localhost:3000/socket.io/socket.io.js"></script>

<script>
  (function () {
    const CUSTOMER_BACKEND_URL = "http://localhost:3000";

    const badge = document.getElementById("staff-new-order-badge");

    function formatMoney(value) {
      return Number(value || 0).toLocaleString("vi-VN") + " đ";
    }

    function removeOldRealtimeNotice() {
      const oldNotice = document.getElementById("staff-realtime-notice");

      if (oldNotice) {
        oldNotice.remove();
      }
    }

    function showRealtimeNotice(options) {
      removeOldRealtimeNotice();

      const notice = document.createElement("div");

      notice.id = "staff-realtime-notice";
      notice.className = "staff-realtime-notice";

      notice.innerHTML = `
        <div class="staff-realtime-title">${options.title}</div>
        <div class="staff-realtime-message">${options.message}</div>

        <div class="staff-realtime-actions">
          <a href="${options.href}">${options.linkText}</a>
          <button type="button" id="close-realtime-notice">Đóng</button>
        </div>
      `;

      const main = document.querySelector(".lc-main");

      if (main) {
        main.prepend(notice);
      } else {
        document.body.prepend(notice);
      }

      const closeButton = document.getElementById("close-realtime-notice");

      if (closeButton) {
        closeButton.addEventListener("click", function () {
          notice.remove();
        });
      }

      setTimeout(function () {
        const currentNotice = document.getElementById("staff-realtime-notice");

        if (currentNotice) {
          currentNotice.remove();
        }
      }, 10000);
    }

    function setPendingOrderCount(count) {
      if (!badge) return;

      const safeCount = Number(count || 0);

      if (safeCount > 0) {
        badge.style.display = "inline-flex";
        badge.innerText = safeCount;
      } else {
        badge.style.display = "none";
        badge.innerText = "0";
      }
    }

    async function loadPendingOrderCount() {
      try {
        const response = await fetch(CUSTOMER_BACKEND_URL + "/api/orders/new-count");
        const data = await response.json();

        if (response.ok) {
          setPendingOrderCount(data.count || 0);
        }
      } catch (error) {
        console.log("Không thể tải số đơn chờ xử lý:", error);
      }
    }

    loadPendingOrderCount();

    setInterval(function () {
      loadPendingOrderCount();
    }, 5000);

    if (!window.io) {
      console.warn("Socket.IO client chưa tải được. Kiểm tra customer backend http://localhost:3000");
      return;
    }

    const socket = io(CUSTOMER_BACKEND_URL, {
      transports: ["websocket", "polling"]
    });

    socket.on("connect", function () {
      console.log("Đã kết nối realtime tới customer backend:", socket.id);
    });

    socket.on("new-order", function (order) {
      console.log("Nhận đơn hàng mới:", order);

      showRealtimeNotice({
        title: "Có đơn hàng mới!",
        message:
          "Có đơn hàng mới từ " +
          (order.customerName || "Khách hàng") +
          " - Tổng tiền: " +
          formatMoney(order.totalAmount),
        href: "/staff/orders",
        linkText: "Xem đơn hàng"
      });

      loadPendingOrderCount();
    });

    socket.on("new-booking", function (booking) {
      console.log("Nhận đặt chỗ mới:", booking);

      showRealtimeNotice({
        title: "Có đặt chỗ mới!",
        message:
          "Có đặt chỗ mới từ " +
          (booking.customerName || "Khách hàng") +
          " - Sự kiện: " +
          (booking.eventName || "Không có tên") +
          " - Báo giá: " +
          formatMoney(booking.estimatedTotal),
        href: "/staff/bookings",
        linkText: "Xem đặt chỗ"
      });
    });

    socket.on("order-status-updated", function () {
      loadPendingOrderCount();
    });
  })();
</script>

</body>
</html>